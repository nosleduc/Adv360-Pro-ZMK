#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        MoTo: MoTo {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&mo>, <&to>;
        };

        CopyCut: CopyCut {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LG(C)>, <&kp LG(X)>;
        };

        longhm: longhm {
            compatible = "zmk,behavior-hold-tap";
            label = "LONGHM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <300>;
            flavor = "tap-preferred";
        };

        LeftBracket: LeftBracket {
            compatible = "zmk,behavior-tap-dance";
            label = "LEFTBRACKET";
            #binding-cells = <0>;
            bindings = <&mt LS(J) LEFT_PARENTHESIS>, <&kp LS(J)>;
        };

        RightBracket: RightBracket {
            compatible = "zmk,behavior-tap-dance";
            label = "RIGHTBRACKET";
            #binding-cells = <0>;
            bindings = <&mt LS(K) RIGHT_PARENTHESIS>, <&kp LS(K)>;
        };

        MoTog: MoTog {
            compatible = "zmk,behavior-hold-tap";
            label = "MOTOG";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    macros {
        MyEnter: MyEnter {
            label = "&MYENTER";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RET &kp LS(LBKT) &kp RET>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";
            bindings = <
&lt 4 EQUAL      &kp N1    &kp N2     &lt 6 N3  &kp NUMBER_4  &kp N5  &MoTo 2 2                                                     &mo 3              &kp N6  &kp N7           &lt 6 N8   &kp N9                &kp N0               &kp MINUS
&kp TAB          &kp Q     &kp W      &kp E     &kp R         &kp T   &none                                                         &kp RIGHT_BRACKET  &kp Y   &kp U            &kp I      &kp O                 &kp P                &kp BSLH
&lt 6 ESCAPE     &kp A     &kp S      &kp D     &kp F         &kp G   &none         &CopyCut    &kp LG(V)       &kp DEL  &kp BSPC   &kp LEFT_BRACKET   &kp H   &kp J            &kp K      &kp L                 &kp SEMI             &kp SQT
&mt LSHFT GRAVE  &kp Z     &kp X      &kp C     &kp V         &kp B                             &kp LG(X)       &none                                  &kp N   &kp M            &kp COMMA  &kp DOT               &kp UP_ARROW         &kp RSHFT
&none            &sk LALT  &sk LCTRL  &kp LGUI  &sk LSHFT             &lt 5 ESCAPE  &MoTog 1 1  &MoTog 2 2      &mo 2    &kp ENTER  &hm RSHFT SPACE            &sk RIGHT_SHIFT  &kp RGUI   &mt RCTRL LEFT_ARROW  &mt LALT DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        nav {
            display-name = "nav";
            bindings = <
&none   &none   &none   &mo 6   &none   &kp F5  &none                                       &none   &none         &none         &none             &none          &none   &none
&trans  &none   &none   &none   &none   &none   &none                                       &none   &kp LA(LEFT)  &kp LA(DOWN)  &kp LA(UP_ARROW)  &kp LA(RIGHT)  &none   &none
&trans  &trans  &none   &none   &none   &none   &none   &trans  &trans      &trans  &trans  &none   &kp LEFT      &kp DOWN      &kp UP_ARROW      &kp RIGHT      &none   &none
&trans  &trans  &trans  &trans  &trans  &none                   &none       &none                   &kp LG(LEFT)  &kp LG(DOWN)  &kp LG(UP_ARROW)  &kp LG(RIGHT)  &none   &none
&trans  &trans  &trans  &trans  &trans          &tog 1  &tog 1  &to 0       &none   &trans  &trans                &trans        &trans            &trans         &trans  &none
            >;
        };

        fn {
            display-name = "fn";
            bindings = <
&none  &kp F1    &kp F2         &kp F3    &kp F4          &kp F5           &none                                          &none   &kp F6  &kp F7     &kp F8    &kp F9     &kp F10          &kp F11
&none  &none     &none          &none     &none           &none            &none                                          &none   &none   &none      &none     &none      &kp PRINTSCREEN  &kp F12
&none  &none     &none          &none     &none           &none            &none   &none       &none       &none  &none   &none   &kp F5  &kp F8     &kp F6    &kp F7     &none            &none
&none  &none     &none          &none     &none           &kp PAUSE_BREAK                      &none       &none                  &none   &none      &none     &none      &none            &none
&none  &kp LALT  &kp LESS_THAN  &kp LGUI  &kp LEFT_SHIFT                   &trans  &MoTog 1 1  &tog 2      &none  &trans  &trans          &kp RSHFT  &kp RGUI  &kp RCTRL  &kp LALT         &none
            >;
        };

        mod {
            display-name = "mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        media {
            display-name = "media";
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                  &none  &none       &none              &none            &none       &none     &none
&none  &none  &none  &none  &none  &none  &none                                  &none  &none       &none              &none            &none       &kp C_PP  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none      &none  &none  &none  &kp C_PREV  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT  &none     &none
&none  &none  &none  &none  &none  &none                &none      &none                &none       &kp C_MUTE         &none            &none       &none     &none
&none  &none  &none  &none  &none         &none  &none  &none      &none  &none  &none              &none              &none            &none       &none     &none
            >;
        };

        symbols {
            display-name = "symbols";
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                     &none            &kp LS(N6)  &kp LS(N7)    &kp LS(N8)     &kp LS(N9)    &kp LS(N0)          &kp LS(MINUS)
&none  &none  &none  &none  &none  &none  &none                                     &kp RIGHT_BRACE  &kp LS(Y)   &kp LS(LBKT)  &kp LS(RBKT)   &kp LS(O)     &kp LS(P)           &kp LS(BSLH)
&none  &none  &none  &none  &none  &none  &none  &none  &none      &none  &none     &kp LEFT_BRACE   &kp LS(H)   &LeftBracket  &RightBracket  &kp LS(L)     &kp LS(SEMI)        &kp DOUBLE_QUOTES
&none  &none  &none  &none  &none  &none                &none      &none                             &kp LS(N)   &kp LS(M)     &kp LS(COMMA)  &kp LS(DOT)   &kp LS(UP_ARROW)    &kp QUESTION
&none  &none  &none  &none  &none         &none  &none  &none      &none  &MyEnter  &none                        &none         &none          &kp LS(LEFT)  &kp LS(DOWN_ARROW)  &kp LS(RIGHT)
            >;
        };

        xcode {
            display-name = "xcode";
            bindings = <
&none  &none  &none  &none          &none          &none          &none                                  &none  &none                   &none                  &none                 &none                &kp LC(KP_NUMBER_0)  &none
&none  &none  &none  &kp LG(LC(E))  &kp LG(R)      &kp LG(LC(T))  &none                                  &none  &none                   &kp LC(NUMBER_6)       &none                 &kp LG(LS(O))        &kp LG(LA(O))        &none
&none  &none  &none  &none          &none          &none          &none  &none  &none      &none  &none  &none  &kp LC(LG(LEFT_ARROW))  &kp LC(LG(DOWN))       &kp LG(LC(UP_ARROW))  &kp LG(LC(J))        &kp LG(LC(RIGHT))    &none
&none  &none  &none  &kp LG(LC(B))  &kp LG(LA(F))  &kp LG(B)                    &none      &none                &kp LC(GRAVE)           &kp LG(LC(LS(ENTER)))  &kp LG(LEFT_BRACE)    &kp LG(RIGHT_BRACE)  &none                &none
&none  &none  &none  &none          &none                         &none  &none  &none      &none  &none  &none                          &none                  &none                 &none                &none                &none
            >;
        };
    };
};
