#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <200>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      MoTo: MoTo {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&mo>, <&to>;
      };

      CopyCut: CopyCut {
        compatible = "zmk,behavior-tap-dance";
        #binding-cells = <0>;
        tapping-term-ms = <200>;
        bindings = <&kp LG(C)>, <&kp LG(X)>;
      };    };

   
    macros {

        MyEnter: MyEnter {
            label = "&MYENTER";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RET>
                , <&kp LS(LBKT)>
                , <&kp RET>;
        };
    };


  keymap {
    compatible = "zmk,keymap";

    base {
      display-name = "base";
      bindings = <
        &lt 4 EQUAL &kp N1    &kp N2   &lt 6 N3   &kp N4     &kp N5 &none                                                           &mo 3 &kp N6 &kp N7 &lt 6 N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &sk LCTRL                                                            &sk RCTRL &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &kp LGUI           &CopyCut &kp LG(V) &kp DEL  &kp BSPC           &kp RGUI &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &MoTo 2 2     &kp GRAVE &kp LALT &hm LCTRL LEFT &hm LGUI RIGHT                &lt 5 ESC &MoTo 1 1   &kp TAB  &kp PG_DN &kp ENTER &hm RSHFT SPACE              &hm RGUI DOWN &hm RCTRL UP  &hm LALT LBKT &hm LALT RBKT &none
      >;
    };

    nav { 
      display-name = "nav";    
      bindings = <
        &none &none &none &none &none &none  &none                                                                    &none &none &none &none &none &none &none 
        &none &none &none &none &none &none  &none                                                                    &none &none &none &kp UP  &none  &none  &none
        &none &none &kp F8 &kp F6 &kp F7 &kp F5  &none        &trans &trans  &trans &trans                       &none &none &kp LEFT &kp DOWN &kp RIGHT  &none  &none
        &none &trans &trans &trans &trans &kp F9                      &none &none                     &kp LG(LC(LEFT)) &kp LC(LG(DOWN)) &kp LC(LG(UP)) &kp LC(LG(J))  &kp LC(LG(RIGHT))  &none
        &none &none &trans &trans &trans               &mt LSHFT ESC &to 0 &none &none &trans &trans              &trans &trans &kp LG(LS(LBKT))  &kp LG(LS(RBKT))  &none
      >;
    };


    fn {
      display-name = "fn";
      bindings = <
        &none &none &none &none &none &none  &none                                          &none &none &none &none &none &none &none 
        &none &none &none &none &none &none  &none                                                &none &kp LS(F10) &kp F9 &kp F10 &kp F11  &kp F12  &none
        &none &none &none &none &none &none  &none        &none &none &none &none                 &none &kp F8 &kp F5 &kp F6 &kp F7  &kp F8  &none
        &none &none &none &none &none &kp PAUSE_BREAK                      &none &none                            &none &kp F1 &kp F2 &kp F3  &kp F4  &none
        &to 0 &none &trans &trans &trans               &trans &none &none &none &trans &trans                       &none &none &none  &none  &none
      >;
    };

    mod {
      display-name = "mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

    media { 
      display-name = "media";    
      bindings = <
        &none &none &none &none &none &none  &none                                           &none &none &none      &none         &none       &none     &none 
        &none &none &none &none &none &none  &none                                           &none &none &none      &kp C_VOL_UP  &none       &kp C_PP  &none
        &none &none &none &none &none &none  &none        &none &none &none &none            &none &none &kp C_PREV &kp C_VOL_DN  &kp C_NEXT  &none     &none
        &none &none &none &none &none &none                      &none &none                       &none &kp C_MUTE &none         &none       &none     &none
        &none &none &none &none &none               &none &none &none &none &none &none                  &none      &none         &none       &none     &none
      >;
    };

    symbols { 
      display-name = "symbols";    
      bindings = <
        &none &none &none &none &none &none  &none                                            &none &kp LS(N6) &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0) &kp LS(MINUS)
        &none &none &none &none &none &none  &none                                           &none &none &kp LS(LBKT) &kp LS(RBKT)  &none  &none  &kp LS(BSLH)
        &none &none &none &none &none &none  &none        &none &none &none &none        &none &none &kp LS(N9) &kp LS(N0) &none  &kp LS(SEMI)  &kp LS(SQT)
        &none &none &none &none &none &none                      &none &none                     &none &none &kp LS(COMMA) &kp LS(DOT)  &kp LS(FSLH)  &none
        &none &none &none &none &none               &none &none &none &none &MyEnter &none              &none &none &kp LS(LBKT)  &kp LS(RBKT)  &none
      >;
    };

    xcode { 
      display-name = "xcode";    
      bindings = <
        &none &none &none &none &none &none  &none                                            &none &none &none &none &none &none &none 
        &none &none &none &kp LG(LC(E)) &kp LG(R) &kp LG(LC(T))  &none                                           &none &none &none &none  &none  &kp LG(LA(O))  &none
        &none &none &none &none &none &none  &none        &none &none &none &none        &none &none &kp LC(N6) &kp LG(LS(O)) &none  &none  &none
        &none &none &none &kp LG(LC(B)) &kp LG(LA(F)) &kp LG(B)                      &none &none                     &kp LC(GRAVE) &kp LG(LC(LS(ENTER))) &none &none  &none  &none
        &none &none &none &none &none               &none &none &none &none &none &none              &none &none &none  &none  &none
      >;
    };
    
    extra4 {
      display-name = "extra4";
      bindings = <
        &none &none &none &none &none &none  &none                                            &none &none &none &none &none &none &none 
        &none &none &none &none &none &none  &none                                           &none &none &none &none &none  &none  &none
        &none &none &none &none &none &none  &none        &none &none &none &none        &none &none &none &none &none  &none  &none
        &none &none &none &none &none &none                      &none &none                     &none &none &none &none  &none  &none
        &none &none &none &none &none               &none &none &none &none &none &none              &none &none &none  &none  &none
      >;
    };

  };
};
